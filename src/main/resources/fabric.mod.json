{
	"schemaVersion": 1,
	"id": "unnamed-dungeons",
	"version": "${version}",
	"name": "Unnamed Dungeons Engine & API",
	"description": "Instanced Dungeon Engine, 3D Flood-Fill Room Detector, NBT Structure Compiler & Combat VFX API for Fabric.",
	"authors": [
		"k8bus"
	],
	"contact": {
		"homepage": "https://fabricmc.net/",
		"sources": "https://github.com/k8bus/unnamed-dungeons"
	},
	"license": "All Rights Reserved",
	"icon": "assets/unnamed-dungeons/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.k8bus.UnnamedDungeons"
		],
		"client": [
			"com.k8bus.client.UnnamedDungeonsClient"
		],
		"fabric-datagen": [
			"com.k8bus.client.UnnamedDungeonsDataGenerator"
		]
	},
	"mixins": [
		"unnamed-dungeons.mixins.json",
		{
			"config": "unnamed-dungeons.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": "~26.2",
		"java": ">=25",
		"fabric-api": "*"
	}
